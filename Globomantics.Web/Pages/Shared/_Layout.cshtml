@using Microsoft.Extensions.Options
@inject IOptions<DeploymentOptions> Deployment
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Globomantics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true">G</span>
                <span class="brand-name">Globomantics</span>
            </a>
            <nav class="nav">
                <a href="#services">Services</a>
                <a href="#approach">Approach</a>
                <a href="#contact">Contact</a>
            </nav>
            <span class="env-badge" title="Value of configuration key DeploymentEnvironment">
                @Deployment.Value.octopusEnvironment
            </span>
        </div>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="container footer-inner">
            <p>&copy; @DateTime.UtcNow.Year Globomantics. Web consulting that ships.</p>
            <p class="muted">Running in <strong>@Deployment.Value.octopusEnvironment</strong> · key: <code>DeploymentEnvironment</code></p>
        </div>
    </footer>
</body>
</html>
